# ==============================================================================
# KubeMind Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Generate strong, cryptographically secure values for all placeholders.
# 3. Never commit .env to version control (.env is excluded in .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Metadata & Runtime Profiles
# ------------------------------------------------------------------------------
APP_NAME=KubeMind
APP_ENV=development
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration (MANDATORY)
# Generate a strong password (at least 24 characters).
# ------------------------------------------------------------------------------
POSTGRES_DB=kubemind
POSTGRES_USER=kubemind_admin
POSTGRES_PASSWORD=<GENERATE_STRONG_DATABASE_PASSWORD_MIN_24_CHARS>
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/kubemind

# ------------------------------------------------------------------------------
# 3. JWT Authentication Security (MANDATORY)
# JJWT requires at least 256 bits (32 bytes). Generate via:
#   openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_SECRET=<GENERATE_CRYPTOGRAPHICALLY_SECURE_256_BIT_SECRET_VIA_OPENSSL>
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 4. Primary Administrator Initialization (One-Time Setup)
# Set KUBEMIND_SETUP_TOKEN to a secure random token to initialize via:
#   POST /api/v1/auth/setup-admin
# Or provide initial admin credentials for headless first-time bootstrap:
# ------------------------------------------------------------------------------
KUBEMIND_SETUP_TOKEN=
KUBEMIND_INITIAL_ADMIN_USERNAME=
KUBEMIND_INITIAL_ADMIN_EMAIL=
KUBEMIND_INITIAL_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 5. Frontend & Network Gateway
# ------------------------------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# ------------------------------------------------------------------------------
# 6. Observability & AI Telemetry
# ------------------------------------------------------------------------------
INTERNAL_API_KEY=<GENERATE_SHARED_SECRET_FOR_INTERNAL_MICROSERVICES>
PROMETHEUS_URL=http://prometheus:9090
AI_SERVICE_PORT=8000
AI_MODEL_NAME=gpt-4o
MCP_SERVER_PORT=8001

# ------------------------------------------------------------------------------
# 7. Optional Third-Party Integrations
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-proj-your-openai-api-key-here
# GITHUB_TOKEN=your-github-pat-token-here
# GITHUB_REPOS=owner/repo
# GRAFANA_URL=http://localhost:3001
# GRAFANA_API_KEY=your-grafana-service-account-token
